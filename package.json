{
  "name": "opie-launcher",
  "productName": "Opie Launcher",
  "version": "0.1.0",
  "description": "Menu radial para Windows: un atajo, una rueda, tus programas.",
  "author": "Juan Romero",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "node check-not-running.js && electron-builder --dir",
    "dist": "node check-not-running.js && electron-builder",
    "test": "node test_radial.js && node test_appscanner.js && node test_config.js && node test_processutils.js"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.juanromero.opielauncher",
    "electronDist": "node_modules/electron/dist",
    "productName": "Opie Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.js",
      "!test_*.js",
      "!check-not-running.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
